---
import "@/styles/global.css"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { locales, ui, type Locale } from "@/i18n/ui"
import { Image } from "astro:assets"
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n"
import { Languages } from "lucide-react"
import logo from "@/assets/vialive-logo.png"

interface Props {
  title?: string
  description?: string
  // Doc pages need room for the sidebar and on-this-page columns.
  wide?: boolean
  // False for a page with no URL of its own in each locale (404): no canonical, hreflang or language toggle.
  localized?: boolean
  // schema.org structured data, rendered as JSON-LD.
  jsonLd?: Record<string, unknown>
  // False on the home page, which shows no App Store badge, to keep its design clean.
  footer?: boolean
}

const siteName = "Vialive"
const ogLocales = { en: "en_US", ko: "ko_KR" }

const locale = (Astro.currentLocale ?? "en") as Locale
const t = ui[locale]
const { title, description = t.tagline, wide = false, localized = true, jsonLd, footer = true } = Astro.props
const width = wide ? "max-w-7xl" : "max-w-3xl"
// Side padding that grows past the notch and rounded corners of a phone in landscape.
const safe = "pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))]"
const fullTitle = title && title !== siteName ? `${title} | ${siteName}` : siteName

const canonical = new URL(Astro.url.pathname, Astro.site).href
const path = Astro.url.pathname.replace(/^\/ko(?=\/)/, "").replace(/^\//, "")
// ponytail: a single toggle while there are two locales; use a shadcn DropdownMenu at three.
const otherLocale = locales.find((l) => l !== locale)!
const image = new URL("/og.png", Astro.site).href
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: backgrounds reach the screen edges on a phone in landscape; `safe` keeps content clear of the notch. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!localized && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      localized && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en", path)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            ...jsonLd,
            publisher: { "@type": "Organization", name: siteName, url: Astro.site!.href },
          })}
        />
      )
    }
  </head>
  <body class="flex min-h-svh flex-col">
    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
      <div class:list={["mx-auto flex h-14 items-center gap-2", safe, width]}>
        <a href={getRelativeLocaleUrl(locale, "")} class="mr-auto flex items-center gap-2 font-medium">
          {/* The logo has white strokes, so it sits on a navy tile. */}
          <span class="flex size-8 items-center justify-center rounded-lg bg-[#161824]">
            <Image src={logo} alt="" width={24} densities={[2, 3]} />
          </span>
          {siteName}
        </a>
        <slot name="header" />
        {
          localized && (
            <a
              href={getRelativeLocaleUrl(otherLocale, path)}
              hreflang={otherLocale}
              lang={otherLocale}
              class={cn(buttonVariants({ variant: "ghost", size: "sm" }))}
            >
              <Languages />
              {t.otherLocale}
            </a>
          )
        }
      </div>
    </header>
    <main class:list={["mx-auto w-full flex-1 py-12", safe, width]}>
      <slot />
    </main>
    {
      footer && (
        <footer class="border-t">
          <p class:list={["mx-auto py-6 text-xs text-muted-foreground", safe, width]}>{t.legal}</p>
        </footer>
      )
    }
  </body>
</html>
